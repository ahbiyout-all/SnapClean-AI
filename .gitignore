# Dependencies & Lockfiles (npm package-lock.json is single source of truth)
node_modules/
.pnp
.pnp.js
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# Build Output & Compiled Bundles
dist/
dist-ssr/
build/
out/
bin/
obj/
*.tsbuildinfo
.vite/
.parcel-cache/

# Binary Executables & Portable Output
*.exe
*.dll
*.so
*.dylib
*.node
*.pdb
*.msi
*.app
snapcleanai-portable*
snapclean_core*

# Rust & Tauri Native Builds
src-tauri/target/
crates/*/target/
target/
Cargo.lock
**/pkg/
*.wasm

# Mobile Legacy Artifacts
*.apk
*.aab
*.ipa
*.mobileconfig
*.xcarchive
snapcleanai-mobile*
snapcleanai-ios*
android/build/
android/.gradle/
ios/build/
ios/Pods/

# Storage & Runtime Cache
coverage/
.nyc_output/
*.tmp
*.temp
*.swp
*.swo
*~
public/mock_storage/*
!public/mock_storage/.gitkeep
.aistudio/
.cache/

# Environment, Credentials & Private Keys (NEVER UPLOAD PERSONAL DATA)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.keystore
*.jks
id_rsa*
firebase-applet-config.json
serviceAccountKey.json

# Operating System Noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE Settings
.idea/
.vscode/*
