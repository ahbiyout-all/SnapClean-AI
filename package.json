{
  "name": "react-example",
  "private": true,
  "version": "2.4.0",
  "author": "SnapClean Team",
  "description": "AI Photo Management",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "node scripts/version-manager.js sync && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:portable": "node scripts/build-portable.js",
    "build:dll": "node scripts/build-dll.js",
    "build:mobile": "node scripts/build-mobile.js",
    "version:sync": "node scripts/version-manager.js sync",
    "version:patch": "node scripts/version-manager.js bump patch",
    "version:minor": "node scripts/version-manager.js bump minor",
    "version:major": "node scripts/version-manager.js bump major",
    "github:sync": "node scripts/github-sync.js sync",
    "github:push": "node scripts/github-sync.js push",
    "github:release": "node scripts/github-sync.js release",
    "release:build": "node scripts/build-release-assets.js",
    "release:push": "node scripts/build-release-assets.js && node scripts/github-sync.js push",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "2.0.0",
    "@tauri-apps/plugin-dialog": "2.0.0",
    "@types/d3": "^7.4.3",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas": "^3.2.3",
    "chokidar": "^5.0.0",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.5",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.0.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
