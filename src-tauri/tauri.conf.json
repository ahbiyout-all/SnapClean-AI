{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapClean",
  "version": "2.4.0",
  "identifier": "com.snapclean.core",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapClean AI",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "incognito": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "*"
        ]
      },
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost data: blob: asset: http://asset.localhost; img-src * 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost; media-src * 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost; connect-src * 'unsafe-inline' ipc: http://ipc.localhost ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
